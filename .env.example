# 生图 / 修图 API 配置（基于 New API / OpenAI 图像接口规范）

# 接口地址：填服务根地址即可，端点路径（/v1/images/...）由脚本拼接。
# 留空则用 scripts/lib.mjs 里的 DEFAULT_BASE_URL，跑 --doctor 会打印实际取值。
IMAGE_API_URL=https://qkmss.com

# 访问凭证：Bearer Token（如 sk-...）。必填。
# 注意：$OPENAI_API_KEY 只在上面的地址确实是 OpenAI 官方（api.openai.com）时才会被采用。
# 地址是中转站 / 自建网关时一律拒用 —— 它通常是 openai.com 的真凭证，发过去等于泄露。
# 所以用中转站就把它自己的凭证显式写在这里。
IMAGE_API_KEY=

# 可用模型列表（多个模型用英文逗号分隔）
# 当用户未指明使用哪个模型时，若配置了多个模型将列出供用户选择；若只有一个模型则直接使用
IMAGE_API_MODELS=gpt-image-2,gpt-image-2.5

# 关于 --size：实测只有 1024x1024 稳定可用，默认不下发该字段（保持上游默认 / 原图比例）。
# 256x256 与 512x512 是 dall-e-2 时代的遗留值，传了必回裸 400，脚本会在本地拦掉。
